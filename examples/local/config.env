# examples/local/config.env — the single source of truth for the local demo.
#
# Everything the driver (mesh-demo.sh) needs is here so there is exactly one
# place to change a name, a CIDR, or an image tag. Every value can be overridden
# from the environment, e.g. `IMAGE=my/agent:test examples/local/mesh-demo.sh up`.

# --- The two kind clusters ----------------------------------------------------
# Cluster names become the kube contexts "kind-<name>".
CLUSTER_A="${CLUSTER_A:-dwx-a}"
CLUSTER_B="${CLUSTER_B:-dwx-b}"

# Stable mesh identities. These are what services are attributed to across the
# mesh and what the MeshPeer objects are named after.
ID_A="${ID_A:-cluster-a}"
ID_B="${ID_B:-cluster-b}"

# Distinct pod and service ranges per cluster. They MUST differ, otherwise the
# agent's overlap guard correctly refuses to route a remote range that would
# hijack local traffic. See the README for the overlapping-CIDR remap feature,
# which is the supported way to run two clusters on the SAME range.
POD_A="${POD_A:-10.244.0.0/16}"; SVC_A="${SVC_A:-10.96.0.0/16}"
POD_B="${POD_B:-10.245.0.0/16}"; SVC_B="${SVC_B:-10.97.0.0/16}"

# --- Agent image --------------------------------------------------------------
# Built locally from this repo and side-loaded into both kind clusters, so the
# demo never pulls from a registry and always runs the code in your tree.
IMAGE="${IMAGE:-datawerx/mesh-agent:demo}"

# --- Install shape ------------------------------------------------------------
# Helm release name. fullnameOverride below pins the DaemonSet name to what the
# `dwx` CLI looks for by default, so `dwx mesh verify` needs no --daemonset flag.
RELEASE="${RELEASE:-dwx}"
NAMESPACE="${NAMESPACE:-datawerx-system}"
FULLNAME="${FULLNAME:-dwx-mesh-agent}"

# The clusterset.local DNS Service name. Pinned so the shared CoreDNS patch
# helper (hack/e2e/patch-coredns.sh) finds it by a stable name.
DNS_SVC_NAME="${DNS_SVC_NAME:-datawerx-mesh-dns}"

# WireGuard UDP port each node listens on. Also the port advertised in the
# reciprocal join bundles. Ignored in routed mode.
WG_PORT="${WG_PORT:-51820}"

# Namespace the demo workload (an echo Service) is deployed into.
DEMO_NS="${DEMO_NS:-demo}"

# --- Data plane ---------------------------------------------------------------
# "wireguard" (default): the agent owns a per-node WireGuard device. This is the
#   flagship path and needs the `wireguard` kernel module on the host.
# "routed": bring-your-own-overlay. The agent programs host routes over an
#   existing overlay instead of owning WireGuard, so no kernel module is needed.
#   In this demo the "overlay" is the shared kind docker network. The
#   control-plane contract (MeshPeer convergence, MCS discovery, the
#   service-by-name call) is identical in both modes.
MODE="${MODE:-wireguard}"

# --- Timeouts (seconds) -------------------------------------------------------
ROLLOUT_TIMEOUT="${ROLLOUT_TIMEOUT:-180}"
CONVERGE_TIMEOUT="${CONVERGE_TIMEOUT:-150}"
